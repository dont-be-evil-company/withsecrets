{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://withsecrets.com/ws.schema.json",
  "title": "Project Configuration File",
  "description": "Schema for a project configuration file with multiple environments.",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z0-9_-]+$": {
      "type": "object",
      "properties": {
        "provider": {
          "description": "The default cloud provider for this environment.",
          "type": "string",
          "enum": ["gcp", "azure", "aws", "openbao", "bitwarden", "local"]
        },
        "project": {
          "description": "The default cloud project for this environment. This can be a string or an integer.",
          "type": ["string", "integer"]
        },
        "region": {
          "description": "Optional cloud region for this environment (used by AWS). Falls back to AWS_REGION / AWS_DEFAULT_REGION when unset.",
          "type": "string"
        },
        "inherits": {
          "description": "One or more environment names to inherit variables from (in order).",
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "cache": {
          "description": "Cache configuration for this environment. Can be a boolean, number (seconds), or duration string (e.g., '1d', '2w', '72h', '2y').",
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" },
            { "type": "string", "pattern": "^(\\d+(?:\\.\\d+)?[smhdwy]|\\d+)$" }
          ]
        },
        "env": {
          "description": "Mapping of environment variable name to configuration object. Use \"*\" with secret-path or param-path to inject path suffixes as env vars without a prefix.",
          "type": "object",
          "patternProperties": {
            "^[A-Z0-9_]+$": {
              "type": "object",
              "properties": {
                "secret-key": { "type": "string" },
                "field": {
                  "type": "string",
                  "description": "OpenBao KV key to return from the secret (like `bao kv get -field`). Only valid with provider openbao and secret-key."
                },
                "secret-path": {
                  "description": "Secret path prefix for bulk loading. A string or an ordered list of strings; later paths overlay earlier ones on name collisions.",
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }]
                },
                "param-key": {
                  "type": "string",
                  "description": "AWS Systems Manager Parameter Store parameter name/path (provider must be aws)."
                },
                "param-path": {
                  "description": "AWS Systems Manager Parameter Store path prefix for bulk loading (provider must be aws). A string or an ordered list of strings; later paths overlay earlier ones on name collisions.",
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }]
                },
                "value": { "type": ["string", "integer"] },
                "provider": {
                  "type": "string",
                  "enum": ["gcp", "azure", "aws", "openbao", "bitwarden", "local"]
                },
                "project": { "type": ["string", "integer"] },
                "region": {
                  "type": "string",
                  "description": "Optional AWS region override for this mapping. Falls back to environment region, then AWS_REGION / AWS_DEFAULT_REGION."
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "provider": { "const": "local" } },
                    "required": ["provider"]
                  },
                  "then": {
                    "required": ["value"],
                    "not": {
                      "anyOf": [
                        { "required": ["secret-key"] },
                        { "required": ["secret-path"] },
                        { "required": ["param-key"] },
                        { "required": ["param-path"] }
                      ]
                    }
                  },
                  "else": {
                    "oneOf": [
                      { "required": ["secret-key"] },
                      { "required": ["secret-path"] },
                      { "required": ["param-key"] },
                      { "required": ["param-path"] },
                      { "required": ["value"] }
                    ]
                  }
                },
                {
                  "if": { "required": ["field"] },
                  "then": { "required": ["secret-key"] }
                },
                {
                  "if": {
                    "required": ["provider"],
                    "properties": { "provider": { "not": { "const": "openbao" } } }
                  },
                  "then": { "not": { "required": ["field"] } }
                }
              ],
              "additionalProperties": false
            },
            "^\\*$": {
              "type": "object",
              "description": "Bulk path injection: inject each secret/parameter under the path as its own env var (suffix after the path, no prefix).",
              "properties": {
                "secret-path": {
                  "description": "Secret path prefix for bulk loading. A string or an ordered list of strings; later paths overlay earlier ones on name collisions.",
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }]
                },
                "param-path": {
                  "description": "AWS Systems Manager Parameter Store path prefix for bulk loading (provider must be aws). A string or an ordered list of strings; later paths overlay earlier ones on name collisions.",
                  "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" }, "minItems": 1 }]
                },
                "provider": {
                  "type": "string",
                  "enum": ["gcp", "azure", "aws", "openbao", "bitwarden"]
                },
                "project": { "type": ["string", "integer"] },
                "region": {
                  "type": "string",
                  "description": "Optional AWS region override for this mapping. Falls back to environment region, then AWS_REGION / AWS_DEFAULT_REGION."
                }
              },
              "oneOf": [{ "required": ["secret-path"] }, { "required": ["param-path"] }],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "required": ["provider"]
        },
        {
          "if": {
            "properties": {
              "provider": {
                "not": {
                  "enum": ["aws", "azure", "openbao", "bitwarden", "local"]
                }
              }
            }
          },
          "then": {
            "required": ["project"]
          }
        },
        {
          "if": { "properties": { "provider": { "const": "local" } } },
          "then": {
            "properties": {
              "env": {
                "patternProperties": {
                  "^[A-Z0-9_]+$": {
                    "allOf": [
                      {
                        "if": { "not": { "required": ["provider"] } },
                        "then": {
                          "required": ["value"],
                          "not": {
                            "anyOf": [
                              { "required": ["secret-key"] },
                              { "required": ["secret-path"] },
                              { "required": ["param-key"] },
                              { "required": ["param-path"] }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "not": { "const": "aws" }
              }
            }
          },
          "then": {
            "properties": {
              "env": {
                "patternProperties": {
                  "^[A-Z0-9_]+$": {
                    "not": {
                      "anyOf": [{ "required": ["param-key"] }, { "required": ["param-path"] }]
                    }
                  },
                  "^\\*$": {
                    "not": {
                      "anyOf": [{ "required": ["param-path"] }]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "not": { "const": "openbao" }
              }
            }
          },
          "then": {
            "properties": {
              "env": {
                "patternProperties": {
                  "^[A-Z0-9_]+$": {
                    "if": { "not": { "required": ["provider"] } },
                    "then": { "not": { "required": ["field"] } }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
