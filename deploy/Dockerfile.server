FROM golang:1.25.8-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/withsecrets-server ./apps/server

FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
    && adduser -D -u 65532 app
COPY --from=build /out/withsecrets-server /app/withsecrets-server
USER app
EXPOSE 8080
ENTRYPOINT ["/app/withsecrets-server"]
