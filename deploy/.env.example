# Compose file. Copy to deploy/.env before use. Do not commit deploy/.env.
POSTGRES_DB=withsecrets
POSTGRES_USER=withsecrets
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://withsecrets:replace-with-a-long-random-password@db:5432/withsecrets?sslmode=disable
WS_DATA_DIR=/var/lib/withsecrets/.data
PUBLIC_BASE_URL=http://127.0.0.1:8080
HTTP_BIND=127.0.0.1
ATTACHMENT_DIR=/var/lib/withsecrets/attachments

# Leave providers empty until you register an OAuth app. The server then
# shows a setup error and does not create anonymous vault sessions.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=

# Never set this on a public hostname. The process refuses to start if you do.
WITHSECRETS_DEV_AUTH=
